            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"99001\",\n  \"name\": \"Mahasiswa Uji Palsu Owner\",\n  \"grade\": \"A\",\n  \"owner_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            },
            "description": "Staff mencoba mengirim 'owner_id': 1 (milik admin). Sistem berhasil membuat data (201 Created), tetapi nilai owner_id di database tetap otomatis menjadi ID Staff pembuatnya (bukan 1)."
          },
          "response": []
        },
        {
          "name": "Negatif 2: User2 Coba Ubah Data User1 (IDOR Attack - Harus 403 Forbidden)",
