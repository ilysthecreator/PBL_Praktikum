    {
      "name": "4. Pengujian Keamanan (Security Tests)",
      "item": [
        {
          "name": "Uji 1: Akses Tanpa Token (Harus 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": "Menguji akses endpoint mahasiswa tanpa menyertakan header Authorization (ekspektasi: 401 Unauthorized + header WWW-Authenticate)."
          },
          "response": []
        },
        {
          "name": "Uji 2: Token Diubah 1 Karakter (Harus 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}x"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": "Menguji token dengan signature yang tidak cocok / dimanipulasi (ekspektasi: 401 'access token tidak valid')."
          },
          "response": []
        },
        {
          "name": "Uji 3: Token Header Alg None (Harus 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJzYXJpIiwicm9sZSI6ImFkbWluIiwiaXNzIjoicHJha3Rpa3VtLWJhY2tlbmQiLCJleHAiOjE5OTk5OTk5OTl9."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": "Menguji serangan Algorithm Confusion dengan token ber-alg 'none' (ekspektasi: 401 'access token tidak valid')."
          },
          "response": []
        },
        {
          "name": "Uji 4: Pakai Refresh Token Lama Yang Dirotasi (Harus 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Setelah request Refresh pertama berhasil, jalankan request ini lagi dengan token yang sama. Token lama sudah dicabut (ekspektasi: 401 'refresh token tidak valid atau sudah kedaluwarsa')."
          },
          "response": []
        }
      ]
