{
  "info": {
    "_postman_id": "a5e4d28f-7489-4a92-b810-7bc3df4b9a55",
    "name": "API Students - Modul 5 (Authentication & Security)",
    "description": "Koleksi Postman untuk pengujian fitur Autentikasi & Keamanan (JWT, bcrypt, rate limiter, token rotation) pada RESTful API Students (Golang Fiber + PostgreSQL).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
