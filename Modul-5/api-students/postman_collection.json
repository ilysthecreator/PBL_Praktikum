    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ilyas\",\n  \"email\": \"ilyas@example.com\",\n  \"password\": \"rahasia123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mendaftar user baru (password di-hash dengan bcrypt cost 12, role default 'user', return 201 Created)."
          },
          "response": []
        },
        {
          "name": "Register - Password Lemah (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"password1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Uji penolakan kata sandi yang terlalu umum atau tidak memenuhi kriteria kekuatan (422 Unprocessable Entity)."
          },
          "response": []
        },
        {
          "name": "Register - Uji Mass Assignment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"hacker\",\n  \"email\": \"hacker@example.com\",\n  \"password\": \"rahasia123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Membuktikan celah Mass Assignment tertutup: field role yang disisipkan client diabaikan oleh server dan role tetap 'user'."
          },
          "response": []
        },
        {
          "name": "Login (Sukses & Simpan Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    if (jsonData.data.access_token) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.data.access_token);",
                  "    }",
                  "    if (jsonData.data.refresh_token) {",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ilyas\",\n  \"password\": \"rahasia123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login berhasil: menghasilkan access_token (15 menit) dan refresh_token (7 hari). Token otomatis tersimpan ke variabel Postman."
          },
          "response": []
        },
        {
          "name": "Login Gagal - Password Salah (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ilyas\",\n  \"password\": \"salahsekali9\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login gagal karena password salah (401 Unauthorized)."
          },
          "response": []
        },
        {
          "name": "Login Gagal - User Tidak Ada (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tidakada\",\n  \"password\": \"salahsekali9\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login gagal karena username tidak terdaftar. Pesan error SAMA PERSIS dengan kasus password salah (mencegah User Enumeration)."
          },
          "response": []
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Mengambil detail profil user yang sedang terautentikasi berdasarkan JWT access token."
          },
          "response": []
        },
        {
          "name": "Refresh Token (Rotasi Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    if (jsonData.data.access_token) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.data.access_token);",
                  "    }",
                  "    if (jsonData.data.refresh_token) {",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Meminta pasangan access_token dan refresh_token baru. Token lama otomatis dicabut (token rotation)."
          },
          "response": []
        },
        {
          "name": "Logout (Cabut Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Mencabut refresh token sehingga tidak bisa lagi dipakai untuk memperbarui access token."
          },
          "response": []
        }
      ]
    },
