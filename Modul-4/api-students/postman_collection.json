              "raw": "{{baseUrl}}/students/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "1"
              ]
            },
            "description": "Menghapus data mahasiswa berdasarkan ID."
          },
          "response": []
        }
      ],
      "description": "Kumpulan endpoint untuk modul mahasiswa"
