            "body": {
              "mode": "raw",
              "raw": "{\n  \"grade\": \"B+\",\n  \"is_active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "1"
              ]
            },
            "description": "Memperbarui sebagian atribut mahasiswa."
          },
          "response": []
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "header": [],
