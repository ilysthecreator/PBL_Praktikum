          "response": []
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"220101001\",\n  \"name\": \"Ahmad Dani\",\n  \"grade\": \"A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": "Menambahkan data mahasiswa baru. Field `nim`, `name`, dan `grade` wajib diisi."
          },
          "response": []
        },
        {
          "name": "Replace Student (PUT / Full Update)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"220101001\",\n  \"name\": \"Ahmad Dani Pratama\",\n  \"grade\": \"A+\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "1"
              ]
            },
            "description": "Mengganti seluruh data mahasiswa berdasarkan ID."
          },
          "response": []
        },
        {
          "name": "Update Student Partial (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
