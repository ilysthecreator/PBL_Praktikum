        {
          "name": "Get All Students (Pagination, Sort, Filter, Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students?page=1&limit=10&sort=id&order=asc&search=&grade=&is_active=",
