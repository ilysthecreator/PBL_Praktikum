                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Nomor halaman (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Jumlah item per halaman (default: 10)"
                },
                {
                  "key": "sort",
                  "value": "id",
                  "description": "Field pengurutan (id, nim, name, grade, created_at)"
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Arah pengurutan (asc/desc)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Pencarian nama atau NIM"
                },
                {
                  "key": "grade",
                  "value": "",
                  "description": "Filter grade/nilai"
                },
                {
                  "key": "is_active",
                  "value": "",
                  "description": "Filter status aktif (true/false)"
                }
              ]
            },
            "description": "Mengambil daftar seluruh mahasiswa beserta metadata pagination."
          },
          "response": []
        },
        {
